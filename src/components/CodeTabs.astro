---
interface Props { slug: string; langs: string[] }
const { slug, langs } = Astro.props as Props

const extMap: Record<string, string> = {
  c:'c', cpp:'cpp', cs:'cs', erl:'erl', ex:'ex', go:'go', java:'java', js:'js',
  kt:'kt', php:'php', py:'py', rkt:'rkt', rb:'rb', rust:'rust', scala:'scala',
  swift:'swift', ts:'ts'
}

// Static glob (required by Vite). We'll filter by slug at runtime
const allFiles = import.meta.glob('/src/code/**/solution.*', { as: 'raw', eager: true }) as Record<string, string>

const sources = langs.map((lang) => {
  const ext = extMap[lang]
  const entry = Object.entries(allFiles).find(([p]) => p.includes(`/src/code/${slug}/`) && p.endsWith(`solution.${ext}`))
  return { lang, code: entry ? entry[1] : '' }
})
---
<div class="mt-6">
  <div role="tablist" class="tabs tabs-boxed overflow-x-auto whitespace-nowrap">
    {sources.map((s, i) => (
      <a role="tab" class={`tab ${i===0 ? 'tab-active' : ''}`} data-tab={`tab-${i}`}>
        {s.lang}
      </a>
    ))}
  </div>
  <div class="mt-3">
    {sources.map((s, i) => (
      <div class={`${i===0 ? '' : 'hidden'}`} data-panel={`tab-${i}`}>
        <pre class="overflow-x-auto"><code class="block min-h-[16rem]">{s.code}</code></pre>
      </div>
    ))}
  </div>
</div>

<script>
  const container = document.currentScript?.parentElement || document
  const tabs = Array.from(container.querySelectorAll('[role="tab"]'))
  const panels = Array.from(container.querySelectorAll('[data-panel]'))
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const key = tab.getAttribute('data-tab')
    tabs.forEach(t => t.classList.remove('tab-active'))
    panels.forEach(p => p.classList.add('hidden'))
    tab.classList.add('tab-active')
    container.querySelector(`[data-panel="${key}"]`)?.classList.remove('hidden')
  }))
</script>


